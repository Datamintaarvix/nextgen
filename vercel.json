{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/vid1.mp4",
      "destination": "/nextgen-dma-ventures-v4/nextgen-dma-ventures/vid1.mp4"
    },
    {
      "source": "/logo.jpeg",
      "destination": "/nextgen-dma-ventures-v4/nextgen-dma-ventures/logo.jpeg"
    },
    {
      "source": "/san.jpeg",
      "destination": "/nextgen-dma-ventures-v4/nextgen-dma-ventures/san.jpeg"
    }
  ]
}
