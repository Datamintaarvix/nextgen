{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "nextgen-dma-ventures",
          "format": "url",
          "env": "NEXTGEN_BACKEND_URL"
        }
      ]
    },
    "nextgen-dma-ventures": {
      "root": "nextgen-dma-ventures-v4/nextgen-dma-ventures",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
