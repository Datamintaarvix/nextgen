# =================================================================
# NEXTGEN DMA VENTURES - SERVER CONFIGURATION & SECRETS
# =================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Razorpay Payment Gateway Credentials (Test or Live)
# Get from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_sampleKeyId123456
RAZORPAY_KEY_SECRET=sampleKeySecret1234567890
RAZORPAY_WEBHOOK_SECRET=sampleWebhookSecret123456

# SMTP Email Configuration (Nodemailer) for Payment Receipts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admissions@nextgendma.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=admissions@nextgendma.com
SMTP_FROM_NAME=NEXTGEN DMA VENTURES Admissions

# Admin Authentication
ADMIN_EMAIL=admin@nextgendma.com
# Secure initial administrator credentials (provide a strong password or bcrypt hash)
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_admin_password_here
ADMIN_DEFAULT_PASSWORD=your_strong_admin_password_here
SESSION_SECRET=your_super_secret_session_key_min_32_characters_here

# Database Configuration (Supabase PostgreSQL / Cloud Data Store)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
DATABASE_URL=

